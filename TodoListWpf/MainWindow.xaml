<Window x:Class="TodoListWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TodoListWpf.Converters"
        xmlns:vm="clr-namespace:TodoListWpf.ViewModels"
        mc:Ignorable="d"
        Title="Todo List - WPF Moderno (Claro / Oscuro)" 
        Height="720" Width="880"
        MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushFondoVentana}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Estilo de Tarjetas Dinámico -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushFondoTarjeta}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.06" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Cajas de Texto Adaptables -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushFondoInput}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoPrimario}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBordeInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushTextoPrimario}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- Estilo de Botón Primario -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushAcento}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoAcento}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAcentoHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón de Peligro / Eliminar -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón Filtro / Secundario -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushFondoBotonFiltro}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoBotonFiltro}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBotonHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Cabecera y Estadísticas -->
            <RowDefinition Height="Auto" /> <!-- Formulario de Entrada -->
            <RowDefinition Height="Auto" /> <!-- Barra de Filtros y Búsqueda -->
            <RowDefinition Height="*" />    <!-- Lista de Tareas -->
            <RowDefinition Height="Auto" /> <!-- Pie -->
        </Grid.RowDefinitions>

        <!-- 1. Cabecera, Contadores y Conmutador de Tema -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título y Subtítulo -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="📝 Mi Todo List" FontSize="26" FontWeight="Bold" 
                           Foreground="{DynamicResource BrushTextoPrimario}" />
                <TextBlock Text="Gestión ágil de tareas con WPF, MVVM y soporte Claro/Oscuro" 
                           FontSize="13" Foreground="{DynamicResource BrushTextoSecundario}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Contadores y Botón de Tema -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Botón de Conmutación de Tema -->
                <Button Command="{Binding CmdAlternarTema}" 
                        Style="{StaticResource FilterButtonStyle}" 
                        Padding="12,6" Margin="0,0,12,0" ToolTip="Alternar entre tema Claro y Oscuro">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨 Tema: " Foreground="{DynamicResource BrushTextoBotonFiltro}" />
                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource BrushTextoBotonFiltro}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="☀️ Claro" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoolModoOscuro}" Value="True">
                                            <Setter Property="Text" Value="🌙 Oscuro" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Badges de Estadísticas -->
                <Border Background="#E0E7FF" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total: " Foreground="#4338CA" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTotalTareas}" Foreground="#4338CA" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pendientes: " Foreground="#B45309" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTareasPendientes}" Foreground="#B45309" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#D1FAE5" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Completadas: " Foreground="#065F46" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTareasCompletadas}" Foreground="#065F46" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Formulario para Agregar Tarea -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Input Título -->
                <TextBox Grid.Row="0" Grid.Column="0"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding StrNuevoTitulo, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Margin="0,0,12,8"
                         VerticalContentAlignment="Center" />

                <!-- Botón Agregar -->
                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Content="➕ Agregar Tarea"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CmdAgregarTarea}"
                        IsDefault="True"
                        Height="76" Width="140" />

                <!-- Input Descripción -->
                <TextBox Grid.Row="1" Grid.Column="0"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding StrNuevaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Margin="0,0,12,0"
                         VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Barra de Filtros y Búsqueda -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filtros por estado -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Todas" 
                        Style="{StaticResource FilterButtonStyle}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Todas" />
                <Button Content="Pendientes" 
                        Style="{StaticResource FilterButtonStyle}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Pendientes" />
                <Button Content="Completadas" 
                        Style="{StaticResource FilterButtonStyle}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Completadas" />
                <TextBlock Text="{Binding StrFiltroActual, StringFormat='(Filtro: {0})'}" 
                           VerticalAlignment="Center" Foreground="{DynamicResource BrushTextoSecundario}" FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- Caja de búsqueda -->
            <TextBox Grid.Column="1"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Text="{Binding StrBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Right" Width="240"
                     FontSize="13" />
        </Grid>

        <!-- 4. Lista de Tareas -->
        <Border Grid.Row="3" Background="{DynamicResource BrushFondoTarjeta}" 
                BorderBrush="{DynamicResource BrushBorde}" BorderThickness="1"
                CornerRadius="10" Padding="8" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ColTareasFiltradas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,4,4,6" Padding="12" 
                                    Background="{DynamicResource BrushFondoItem}" 
                                    BorderBrush="{DynamicResource BrushBorde}" BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox de completado -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding BoolCompletada, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Cursor="Hand" />

                                    <!-- Textos de la Tarea -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Opacity="{Binding BoolCompletada, Converter={StaticResource BoolToOpacityConverter}}">
                                        <TextBlock Text="{Binding StrTituloTarea}" 
                                                   FontSize="15" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource BrushTextoPrimario}"
                                                   TextDecorations="{Binding BoolCompletada, Converter={StaticResource BoolToStrikethroughConverter}}" />

                                        <TextBlock Text="{Binding StrDescripcionTarea}" 
                                                   FontSize="13" Foreground="{DynamicResource BrushTextoSecundario}" 
                                                   Margin="0,2,0,4" TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding DtmFechaCreacion, StringFormat='Creado: {0:dd/MM/yyyy HH:mm}'}" 
                                                   FontSize="11" Foreground="{DynamicResource BrushTextoMuted}" />
                                    </StackPanel>

                                    <!-- Botón Eliminar -->
                                    <Button Grid.Column="2" Content="🗑️ Eliminar"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.CmdEliminarTarea, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 5. Barra Inferior / Acciones secundarias -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Consejo: Usa el botón 'Tema' para alternar entre Claro y Oscuro según tu preferencia." 
                       VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource BrushTextoSecundario}" />

            <Button Grid.Column="1" 
                    Content="🧹 Limpiar completadas" 
                    Style="{StaticResource FilterButtonStyle}"
                    Command="{Binding CmdLimpiarCompletadas}" />
        </Grid>
    </Grid>
</Window>
