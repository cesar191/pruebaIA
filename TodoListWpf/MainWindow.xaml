<Window x:Class="TodoListWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TodoListWpf.Converters"
        xmlns:vm="clr-namespace:TodoListWpf.ViewModels"
        mc:Ignorable="d"
        Title="Todo List - WPF Moderno" 
        Height="700" Width="850"
        MinHeight="550" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Estilo de Tarjetas -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.08" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón Primario -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#93C5FD" />
                                <Setter Property="Foreground" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botón de Peligro / Eliminar -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Filtro Pill -->
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Cabecera y Estadísticas -->
            <RowDefinition Height="Auto" /> <!-- Formulario de Nueva Tarea -->
            <RowDefinition Height="Auto" /> <!-- Barra de Filtros y Búsqueda -->
            <RowDefinition Height="*" />    <!-- Lista de Tareas -->
            <RowDefinition Height="Auto" /> <!-- Pie con Acciones -->
        </Grid.RowDefinitions>

        <!-- 1. Cabecera y Contadores -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="📝 Mi Todo List" FontSize="26" FontWeight="Bold" Foreground="#1F2937" />
                <TextBlock Text="Gestión ágil de tareas con WPF y arquitectura MVVM" FontSize="13" Foreground="#6B7280" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Badges de Estadísticas -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E0E7FF" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total: " Foreground="#4338CA" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTotalTareas}" Foreground="#4338CA" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pendientes: " Foreground="#B45309" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTareasPendientes}" Foreground="#B45309" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#D1FAE5" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Completadas: " Foreground="#065F46" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTareasCompletadas}" Foreground="#065F46" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Formulario para Agregar Tarea -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Input Título -->
                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding StrNuevoTitulo, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="10,8" Margin="0,0,12,8"
                         BorderBrush="#D1D5DB" BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Tag="¿Qué necesitas hacer? (Escribe el título de la tarea)" />

                <!-- Botón Agregar -->
                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Content="➕ Agregar Tarea"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CmdAgregarTarea}"
                        IsDefault="True"
                        Height="78" Width="140" />

                <!-- Input Descripción -->
                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding StrNuevaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13" Padding="10,6" Margin="0,0,12,0"
                         BorderBrush="#D1D5DB" BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Tag="Notas o detalles adicionales (opcional)" />
            </Grid>
        </Border>

        <!-- 3. Barra de Filtros y Búsqueda -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filtros por estado -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Todas" 
                        Style="{StaticResource FilterButtonStyle}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Todas" />
                <Button Content="Pendientes" 
                        Style="{StaticResource FilterButtonStyle}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Pendientes" />
                <Button Content="Completadas" 
                        Style="{StaticResource FilterButtonStyle}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Completadas" />
                <TextBlock Text="{Binding StrFiltroActual, StringFormat='(Filtro: {0})'}" 
                           VerticalAlignment="Center" Foreground="#6B7280" FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- Caja de búsqueda -->
            <TextBox Grid.Column="1"
                     Text="{Binding StrBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Right" Width="240"
                     Padding="8,6" FontSize="13"
                     BorderBrush="#D1D5DB" BorderThickness="1" />
        </Grid>

        <!-- 4. Lista de Tareas -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="10" Padding="8" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ColTareasFiltradas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,4,4,6" Padding="12" Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox de completado -->
                                    <CheckBox Grid.Column="0" 
                                              IsChecked="{Binding BoolCompletada, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Cursor="Hand" />

                                    <!-- Textos de la Tarea -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Opacity="{Binding BoolCompletada, Converter={StaticResource BoolToOpacityConverter}}">
                                        <TextBlock Text="{Binding StrTituloTarea}" 
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#111827"
                                                   TextDecorations="{Binding BoolCompletada, Converter={StaticResource BoolToStrikethroughConverter}}" />

                                        <TextBlock Text="{Binding StrDescripcionTarea}" 
                                                   FontSize="13" Foreground="#4B5563" Margin="0,2,0,4"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding DtmFechaCreacion, StringFormat='Creado: {0:dd/MM/yyyy HH:mm}'}" 
                                                   FontSize="11" Foreground="#9CA3AF" />
                                    </StackPanel>

                                    <!-- Botón Eliminar -->
                                    <Button Grid.Column="2" Content="🗑️ Eliminar"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DataContext.CmdEliminarTarea, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 5. Barra Inferior / Acciones secundarias -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="Consejo: Usa las casillas para marcar tareas y los botones de filtro para organizarte." 
                       VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />

            <Button Grid.Column="1" 
                    Content="🧹 Limpiar completadas" 
                    Style="{StaticResource FilterButtonStyle}"
                    Command="{Binding CmdLimpiarCompletadas}" />
        </Grid>
    </Grid>
</Window>
