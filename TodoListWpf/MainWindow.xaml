<Window x:Class="TodoListWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TodoListWpf.Converters"
        xmlns:vm="clr-namespace:TodoListWpf.ViewModels"
        mc:Ignorable="d"
        Title="Todo List Studio" 
        Height="760" Width="920"
        MinHeight="600" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushFondoVentana}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Estilo de Barra de Desplazamiento Delgada y Moderna -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource BrushScrollbarThumb}" CornerRadius="3" Margin="2,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Circular Moderno -->
        <Style x:Key="ModernCircularCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Círculo exterior -->
                            <Border x:Name="OuterCircle"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushBordeHover}"
                                    Background="Transparent">
                                <!-- Checkmark vectorial -->
                                <Path x:Name="CheckGlyph"
                                      Data="M 6 11 L 9.5 14.5 L 16 7.5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{DynamicResource BrushAcento}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="Background" Value="{DynamicResource BrushAcento}" />
                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{DynamicResource BrushAcento}" />
                                <Setter TargetName="CheckGlyph" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Tarjetas con Sombra Suave -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushFondoTarjeta}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Opacity="0.05" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Primario con Estilo Moderno -->
        <Style x:Key="PrimaryModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushAcento}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoAcento}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushAcentoHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Fantasma / Peligro -->
        <Style x:Key="GhostDangerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoMuted}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushPeligroFondo}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushPeligroTexto}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Píldora para Filtros -->
        <Style x:Key="FilterPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushFondoBotonFiltro}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextoBotonFiltro}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource BrushBotonHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Cabecera principal -->
            <RowDefinition Height="Auto" /> <!-- Tarjeta de Inserción -->
            <RowDefinition Height="Auto" /> <!-- Controles de Filtros y Búsqueda -->
            <RowDefinition Height="*" />    <!-- Lista de Tareas y Empty State -->
            <RowDefinition Height="Auto" /> <!-- Pie de Aplicación -->
        </Grid.RowDefinitions>

        <!-- 1. Cabecera Principal y Métricas -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título estilizado -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushAcentoSuave}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Todo List Studio" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextoPrimario}" />
                        <TextBlock Text="Organiza tus tareas con fluidez, estilo y foco" FontSize="12" Foreground="{DynamicResource BrushTextoSecundario}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Botón Tema y Badges -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Conmutador de Tema -->
                <Button Command="{Binding CmdAlternarTema}" 
                        Style="{StaticResource FilterPillButton}" 
                        Padding="12,7" Margin="0,0,12,0" ToolTip="Conmutar entre tema Claro y Oscuro">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨 " FontSize="12" />
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BrushTextoBotonFiltro}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Tema Claro" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoolModoOscuro}" Value="True">
                                            <Setter Property="Text" Value="Tema Oscuro" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Badges de Estadísticas con Colores Semánticos -->
                <Border Background="{DynamicResource BrushBadgeTotalFondo}" CornerRadius="10" Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total " FontSize="11" Foreground="{DynamicResource BrushBadgeTotalTexto}" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTotalTareas}" FontSize="12" Foreground="{DynamicResource BrushBadgeTotalTexto}" FontWeight="Bold" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BrushBadgePendienteFondo}" CornerRadius="10" Padding="12,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pendientes " FontSize="11" Foreground="{DynamicResource BrushBadgePendienteTexto}" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTareasPendientes}" FontSize="12" Foreground="{DynamicResource BrushBadgePendienteTexto}" FontWeight="Bold" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BrushBadgeCompletadaFondo}" CornerRadius="10" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hechas " FontSize="11" Foreground="{DynamicResource BrushBadgeCompletadaTexto}" FontWeight="Medium" />
                        <TextBlock Text="{Binding IntTareasCompletadas}" FontSize="12" Foreground="{DynamicResource BrushBadgeCompletadaTexto}" FontWeight="Bold" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Formulario de Nueva Tarea (Card Elevada) -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Input Título con Watermark -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,14,10">
                    <Border Background="{DynamicResource BrushFondoInput}"
                            BorderBrush="{DynamicResource BrushBordeInput}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBox Text="{Binding StrNuevoTitulo, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" FontWeight="Medium"
                                     Foreground="{DynamicResource BrushTextoPrimario}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="14,10"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource BrushAcento}" />
                            <TextBlock Text="¿Qué necesitas lograr hoy? (Escribe el título y presiona Enter)"
                                       Foreground="{DynamicResource BrushTextoMuted}"
                                       FontSize="13" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StrNuevoTitulo}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Botón Agregar con Icono -->
                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        Style="{StaticResource PrimaryModernButton}"
                        Command="{Binding CmdAgregarTarea}"
                        IsDefault="True"
                        Height="88" Width="148">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="✨" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Agregar Tarea" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                </Button>

                <!-- Input Descripción con Watermark -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                    <Border Background="{DynamicResource BrushFondoInput}"
                            BorderBrush="{DynamicResource BrushBordeInput}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <TextBox Text="{Binding StrNuevaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Foreground="{DynamicResource BrushTextoPrimario}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="14,8"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource BrushAcento}" />
                            <TextBlock Text="Notas o contexto adicional (opcional)..."
                                       Foreground="{DynamicResource BrushTextoMuted}"
                                       FontSize="12" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StrNuevaDescripcion}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Barra de Filtros y Búsqueda Estilizada -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Píldoras de Filtro -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Todas" 
                        Style="{StaticResource FilterPillButton}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Todas">
                    <Button.Triggers>
                        <!-- Feedback visual -->
                    </Button.Triggers>
                </Button>
                <Button Content="Pendientes" 
                        Style="{StaticResource FilterPillButton}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Pendientes" />
                <Button Content="Completadas" 
                        Style="{StaticResource FilterPillButton}" 
                        Command="{Binding CmdCambiarFiltro}" CommandParameter="Completadas" />

                <!-- Indicador de filtro activo -->
                <Border Background="{DynamicResource BrushAcentoSuave}" CornerRadius="12" Padding="10,4" Margin="6,0,0,0">
                    <TextBlock Text="{Binding StrFiltroActual, StringFormat='Vista activa: {0}'}" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAcentoTextoSuave}" />
                </Border>
            </StackPanel>

            <!-- Barra de Búsqueda con Icono -->
            <Border Grid.Column="1" HorizontalAlignment="Right" Width="260"
                    Background="{DynamicResource BrushFondoInput}"
                    BorderBrush="{DynamicResource BrushBordeInput}"
                    BorderThickness="1" CornerRadius="16" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             Text="{Binding StrBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource BrushTextoPrimario}"
                             FontSize="12" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource BrushAcento}" />

                    <TextBlock Grid.Column="1" Text="Buscar tarea..."
                               Foreground="{DynamicResource BrushTextoMuted}"
                               FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StrBusqueda}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Botón Limpiar Búsqueda -->
                    <Button Grid.Column="2" Content="✕" 
                            Command="{Binding CmdLimpiarBusqueda}"
                            Foreground="{DynamicResource BrushTextoMuted}"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" FontSize="10" Padding="4,0"
                            Visibility="{Binding StrBusqueda, Converter={StaticResource BoolToVisConverter}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Contenedor de Lista de Tareas y Empty State -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}" Padding="12" Margin="0,0,0,16">
            <Grid>
                <!-- Empty State (Cuando la lista filtrada no tiene elementos) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40"
                            Visibility="{Binding BoolListaVacia, Converter={StaticResource BoolToVisConverter}}">
                    <Border Background="{DynamicResource BrushAcentoSuave}" Width="64" Height="64" CornerRadius="32"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="🎯" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="¡No hay tareas en esta vista!" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource BrushTextoPrimario}" HorizontalAlignment="Center" />
                    <TextBlock Text="Agrega una nueva tarea arriba o selecciona otro filtro para explorar." 
                               FontSize="13" Foreground="{DynamicResource BrushTextoSecundario}" 
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- ScrollViewer con ItemsControl -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding BoolTieneTareasFiltradas, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl ItemsSource="{Binding ColTareasFiltradas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Tarjeta Individual de Tarea -->
                                <Border Margin="4,4,4,8" Padding="14,12"
                                        Background="{DynamicResource BrushFondoItem}"
                                        BorderBrush="{DynamicResource BrushBorde}"
                                        BorderThickness="1" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBordeHover}" />
                                                    <Setter Property="Background" Value="{DynamicResource BrushFondoItemHover}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Checkbox Circular -->
                                            <ColumnDefinition Width="*" />    <!-- Contenido Textual -->
                                            <ColumnDefinition Width="Auto" /> <!-- Botón de Borrado -->
                                        </Grid.ColumnDefinitions>

                                        <!-- CheckBox Circular -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding BoolCompletada, Mode=TwoWay}"
                                                  Style="{StaticResource ModernCircularCheckBox}"
                                                  Margin="0,0,14,0" />

                                        <!-- Título, Descripción y Metadatos -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    Opacity="{Binding BoolCompletada, Converter={StaticResource BoolToOpacityConverter}}">
                                            
                                            <!-- Título de la Tarea -->
                                            <TextBlock Text="{Binding StrTituloTarea}" 
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextoPrimario}"
                                                       TextDecorations="{Binding BoolCompletada, Converter={StaticResource BoolToStrikethroughConverter}}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Descripción si existe -->
                                            <TextBlock Text="{Binding StrDescripcionTarea}" 
                                                       FontSize="13" Foreground="{DynamicResource BrushTextoSecundario}"
                                                       Margin="0,4,0,6" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Metadata: Fecha de Creación con Badge -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="📅 Creada: " FontSize="11" Foreground="{DynamicResource BrushTextoMuted}" />
                                                <TextBlock Text="{Binding DtmFechaCreacion, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}" 
                                                           FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextoMuted}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Botón de Borrado Minimalista -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource GhostDangerButton}"
                                                Command="{Binding DataContext.CmdEliminarTarea, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Eliminar esta tarea"
                                                VerticalAlignment="Center" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗑️" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text=" Borrar" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 5. Barra Inferior / Pie de Aplicación -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💡 Atajo: Escribe el título y presiona Enter para añadir rápidamente." 
                           FontSize="12" Foreground="{DynamicResource BrushTextoSecundario}" />
            </StackPanel>

            <!-- Acción de Limpieza de Completadas -->
            <Button Grid.Column="1" 
                    Content="🧹 Limpiar Completadas" 
                    Style="{StaticResource FilterPillButton}"
                    Command="{Binding CmdLimpiarCompletadas}"
                    Padding="14,7" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
